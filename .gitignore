# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# Project-local / private (not part of deliverable)
# .workbuddy/（无 -ai）是旧版 Agent 工作目录：含 2026-08/09 会话日志，
# 其中 2026-09-27.md 曾明文记录过一个 PAT（从未推送，但属红线）。
.workbuddy/
outputs/

# Agent 工作区：memory 是交付物（供跨会话承接），但临时凭据/中间文件绝不入库
.workbuddy-ai/tmp/
.workbuddy-ai/*.pat
.workbuddy-ai/pat*.txt
.workbuddy-ai/push_args.txt
.workbuddy-ai/push_cmd.txt
*_pat*.txt

# 历史归档（保留在本地供追溯，不进公开仓库；理由见 _archive/*/README.md）
_archive/

# main 分支只承载交付物；过程产物与历史副本在 prod 分支
_*.txt
_*.py
_*.out
x.db
# 子目录内的临时探针/输出（根目录规则只作用于根，需单独列出）
scripts/_*.py
scripts/_*.txt

# OS
.DS_Store
Thumbs.db

# Derived index（由 engine/local_search.py 的 rebuild() 从源 JSON 重建，勿提交二进制）
data/search_index/

# Logs
*.log
data/_test_feedback_log.json
data/*.bak
data/*.test.*

# 数据备份与运行时缓存（非交付物，勿提交）
data/*.bak_*
data/_demo_runtime/
data/shared_cache/
data/snapshots/

# 构建产物（MCPB 分发包指向 GitHub Releases，不入库；见 scripts/build_mcpb.py）
dist/

# 部署配置（含 ECS 主机地址等环境信息，不入公开仓库；模板见 deploy_config.example.sh）
deploy/deploy_config.sh

