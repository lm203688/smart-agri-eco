# 智慧农业生态 · 环境变量模板
# 复制为 .env 后按需填写；本项目支持 30 个环境变量，全部零依赖 stdlib 实现。
# 密钥文件路径（.env 里写路径即可，密钥本身绝不进 git）。

# ============================================================================
# 视觉后端（可选，OpenAI 兼容视觉对话接口）
#   未配置 AGRI_VISION_URL / AGRI_VISION_KEY 时视觉自动降级（规则诊断仍可用）
# ============================================================================
# AGRI_VISION_URL=https://api.openai.com/v1
# AGRI_VISION_KEY=sk-xxxx
# AGRI_VISION_MODEL=gpt-4o-mini
# 其他可选后端：ATEX (150.158.119.19:8420/v1) / SenseNova (https://token.sensenova.cn/v1) / 本地 Ollama (http://127.0.0.1:11434/v1)

# ============================================================================
# bp_screen（农业投资初筛系统，独立端口 8010）
# ============================================================================
# AGRI_ASSESS_PORT=8010
# AGRI_BP_DB=data/bp_screen_cases.db
# AGRI_BP_WEB_HOST=0.0.0.0
# AGRI_BP_WEB_PORT=8010
# AGRI_BP_LLM_URL=https://api.openai.com/v1
# AGRI_BP_LLM_KEY=sk-xxxx
# AGRI_BP_LLM_MODEL=gpt-4o-mini

# ============================================================================
# 演示服务（默认 8000 常被占，本项目专用 8020）
# ============================================================================
# AGRI_DEMO_PORT=8020
# AGRI_DEMO_HOST=127.0.0.1
# AGRI_FEEDBACK_DRY_RUN=1              # Demo 模式下不落盘 feedback_log
# AGRI_MEMORY_SYNTHETIC=1              # Demo 模式下 memory 走 synthetic 通道

# ============================================================================
# GitHub 推送（scripts/gh_push.py 用；本机 github.com:443 被封，只走 Contents API）
# ============================================================================
# AGRI_GH_REPO=lm203688/smart-agri-eco
# AGRI_GH_BRANCH=main

# ============================================================================
# Jev 决策层（TypeSafe System One，仅用于判断/门禁，不产数据）
#   密钥绝不进 prompt/git；三级回退：env → TYPESAFE_KEY → 凭证文件
# ============================================================================
# TYPESAFE_API_KEY=ts_live_xxx           # 首选
# TYPESAFE_KEY=ts_live_xxx               # 别名
# TYPESAFE_CRED_FILE=~/.config/typesafe/credentials.json   # 路径覆盖（键名 api_key）
# 缺 key 时 Jev 自动跳过不联网，错误 fail-closed，绝不回写主链。

# ============================================================================
# 数据源（可切换/调试用；默认全部走官方稳定入口）
# ============================================================================
# AGRI_SOILGRIDS_HOST=rest.isric.org     # 正确主机（api.isric.org 不存在，绝不可改回）
# AGRI_SOILGRIDS_TIMEOUT=15
# AGRI_SOIL_INSECURE=0                   # 1 = 跳过 TLS 校验（应急用）
# AGRI_ZONE_META=data/zone_meta/global_zones.json
# AGRI_CROP_DB=data/crop_adapt_db.json
# AGRI_KG_PATH=data/knowledge_graph.json
# AGRI_ORG_MEMORY=data/org_memory.json

# ============================================================================
# 测试 / 巡检
# ============================================================================
# AGRI_LIVE_TEST=1                       # 1 = 巡检真联网取数；默认 0（离线）
# AGRI_VERIFY_NO_ISOLATE=0               # 1 = 跳过隔离验证（仅紧急排查用）
# AGRI_MCP_AUDIT_LOG=data/mcp_audit.log  # MCP 工具调用审计日志

# ============================================================================
# 进化 / 演化基准（PenguinHarness 自进化闭环用）
# ============================================================================
# AGRI_EVOLUTION_SNAPSHOTS=data/snapshots/
# AGRI_EVOLUTION_BENCHMARK=data/benchmarks/
