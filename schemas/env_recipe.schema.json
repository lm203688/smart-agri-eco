{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lm203688/smart-agri-eco/main/schemas/env_recipe.schema.json",
  "title": "Env Recipe (环境配置配方) v1.2",
  "description": "智慧农业生态 · Env Recipe 协议 v1 的 JSON Schema。一份 Env Recipe = 作物 × 生长阶段 × 箱体条件 → 温湿/光谱/PPFD/CO2/EC/pH/水肥/气流/异常处理 的可执行参数集，是所有种植硬件与 Agent 共享的『配方语言』。execution_log / outcome / image_consent 为 day-1 必须留位的独占数据字段（配方→执行→结果三元组 + 中文病虫害图像），事后补字段是数据工程里最贵的错误。v1.2 新增 HA 生态事实标准字段（vpd_kpa / dew_point_c / mold_risk / dli_umol_m2_day）与 OpenFarm 共识字段（companion_plants / sowing_depth_cm），全部 optional 且带溯源元数据（source/derived_at/method），供下游温室/箱体调控按行业惯例消费。",
  "x-schema-maintenance-note": "v1.2.1：删除未使用的 zone_note 字段（GAP_AUDIT §E1：schema 声明但 152 份配方零使用，属于『schema 与数据双向漂移』的反例。新增字段前需先在 scripts/validate_env_recipe.py 中定义用途与消费方。",
  "type": "object",
  "required": [
    "protocol",
    "recipe_version",
    "crop",
    "stage",
    "environment"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "env-recipe",
      "description": "协议标识，固定为 env-recipe。"
    },
    "recipe_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Env Recipe 协议版本（语义化版本）。当前规范版本 1.0.0（协议层不变；schema 版本 1.1.0 新增 zone_note 可选字段）。"
    },
    "crop": {
      "type": "object",
      "required": [
        "species"
      ],
      "additionalProperties": false,
      "properties": {
        "species": {
          "type": "string",
          "description": "作物中文名，如 番茄 / 生菜。"
        },
        "latin": {
          "type": "string",
          "description": "拉丁学名，如 Solanum lycopersicum。"
        },
        "family": {
          "type": "string",
          "description": "科属，如 茄科。"
        }
      }
    },
    "stage": {
      "type": "string",
      "enum": [
        "seed",
        "seedling",
        "vegetative",
        "flowering",
        "fruiting",
        "harvest",
        "full_cycle"
      ],
      "description": "适用生长阶段。full_cycle 表示跨阶段通用配方。"
    },
    "device_profile": {
      "type": "object",
      "description": "目标箱体/设备画像，用于配方适配。",
      "additionalProperties": false,
      "properties": {
        "device_class": {
          "type": "string",
          "enum": [
            "balcony",
            "windowsill",
            "indoor_cabinet",
            "aerogarden_orphan",
            "greenhouse",
            "open_field",
            "other"
          ],
          "description": "设备类别。aerogarden_orphan = AeroGarden 等沦为孤儿设备的存量智能种植机（协议重点自救对象）。"
        },
        "volume_l": {
          "type": "number",
          "minimum": 0,
          "description": "种植容器/箱体有效容积（升）。"
        },
        "light_type": {
          "type": "string",
          "enum": [
            "full_spectrum_led",
            "red_blue_led",
            "sunlight",
            "unknown"
          ],
          "description": "补光类型；unknown 表示设备未声明。"
        },
        "sensor_capability": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "temp",
              "humidity",
              "ppfd",
              "co2",
              "ec",
              "ph",
              "camera"
            ]
          },
          "description": "设备具备的传感器能力；决定配方可被多少参数闭环校准。"
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "可执行环境参数集（配方核心）。",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "day_c": {
              "type": "number",
              "description": "日间目标温度（℃）。"
            },
            "night_c": {
              "type": "number",
              "description": "夜间目标温度（℃）。"
            }
          }
        },
        "humidity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "max_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "light": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ppfd_umol": {
              "type": "number",
              "minimum": 0,
              "description": "目标光合光子通量密度（μmol/m²/s）。"
            },
            "photoperiod_h": {
              "type": "number",
              "minimum": 0,
              "maximum": 24,
              "description": "日光照时长（小时）。"
            },
            "spectrum": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "blue_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "red_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "white_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "far_red_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        },
        "co2_ppm": {
          "type": "number",
          "minimum": 0,
          "description": "目标 CO2 浓度（ppm）；露天可省略。"
        },
        "water_nutrient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ec_ms": {
              "type": "number",
              "minimum": 0,
              "description": "电导率（mS/cm）。"
            },
            "ph": {
              "type": "number",
              "minimum": 0,
              "maximum": 14
            },
            "npk_ratio": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "n": {
                  "type": "number",
                  "minimum": 0
                },
                "p": {
                  "type": "number",
                  "minimum": 0
                },
                "k": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "water_ml_day": {
              "type": "number",
              "minimum": 0,
              "description": "日均灌溉量（ml）。"
            }
          }
        },
        "airflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "mps": {
              "type": "number",
              "minimum": 0,
              "description": "可选：风速（m/s）精确值。"
            }
          }
        },
        "substrate": {
          "type": "string",
          "description": "基质/介质，如 椰糠 / 岩棉 / 营养土。"
        },
        "vpd_kpa": {
          "type": "object",
          "description": "HA 事实标准字段（v1.2 新增，optional）。水汽压亏缺 VPD（kPa），从 environment.temperature + humidity 派生。带 source/derived_at/method 溯源元数据，用于区分「人工设定」与「机器派生」。",
          "additionalProperties": true,
          "properties": {
            "nominal": {"type": "number", "description": "标称 VPD（温湿区间中点）"},
            "envelope_min": {"type": "number"},
            "envelope_max": {"type": "number"},
            "unit": {"const": "kPa"},
            "method": {"type": "string"},
            "source": {"type": "string"},
            "derived_at": {"type": "string", "format": "date-time"}
          }
        },
        "dew_point_c": {
          "type": "object",
          "description": "HA 事实标准字段（v1.2 新增，optional）。露点温度（°C），从 environment.temperature + humidity 派生。",
          "additionalProperties": true,
          "properties": {
            "day_max": {"type": "number"},
            "night": {"type": "number"},
            "unit": {"const": "celsius"},
            "method": {"type": "string"},
            "source": {"type": "string"},
            "derived_at": {"type": "string", "format": "date-time"}
          }
        },
        "mold_risk": {
          "type": "object",
          "description": "HA 事实标准字段（v1.2 新增，optional）。真菌病害风险等级（low/medium/high/unknown），从 VPD + 夜露点判据派生。",
          "additionalProperties": true,
          "properties": {
            "level": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
            "reason": {"type": "string"},
            "vpd_nominal_kpa": {"type": "number"},
            "dew_point_night_c": {"type": "number"},
            "thresholds": {"type": "object"},
            "method": {"type": "string"},
            "source": {"type": "string"},
            "derived_at": {"type": "string", "format": "date-time"}
          }
        },
        "dli_umol_m2_day": {
          "type": "object",
          "description": "【已弃用 · P0-4 拆分】HA 事实标准字段（v1.2 新增，optional，deprecated）。旧字段名易被自动消费者误读为标准 PAR DLI，实际是全年气候基线的全谱短波辐射光子当量（非标准 PAR）。保留只读兼容：读旧字段时应同时检查 deprecated 标记；已由 shortwave_photon_equivalent 与 par_dli 取代。",
          "additionalProperties": true,
          "properties": {
            "value": {"type": "number"},
            "unit": {"const": "umol_m2_day"},
            "zone_id": {"type": "string"},
            "source": {"type": "string"},
            "method": {"type": "string"},
            "derived_at": {"type": "string", "format": "date-time"},
            "deprecated": {"type": "boolean"},
            "deprecated_reason": {"type": "string"},
            "replaced_by": {"type": "array", "items": {"type": "string"}}
          }
        },
        "shortwave_photon_equivalent": {
          "type": "object",
          "description": "HA 事实标准字段（P0-4 拆分后，optional）。全谱短波辐射光子当量（umol/m²/day），从分区 climate_baseline 派生（NASA POWER ALLSKY_SFC_SW_DWN）。注意：这是全谱短波当量，非标准 PAR DLI；PAR 占全谱约 45%-50%（随纬度/云量/季节变化，项目内无实测）。",
          "additionalProperties": true,
          "properties": {
            "value": {"type": "number"},
            "unit": {"const": "umol_m2_day"},
            "zone_id": {"type": "string"},
            "source": {"type": "string"},
            "method": {"type": "string"},
            "derived_at": {"type": "string", "format": "date-time"},
            "spectral_definition": {"const": "full_spectrum_shortwave"},
            "temporal_resolution": {"const": "annual_mean"},
            "latitude_deg": {"type": ["number", "null"]},
            "uncertainty": {"type": "object"}
          }
        },
        "par_dli": {
          "type": "object",
          "description": "HA 事实标准字段（P0-4 拆分后，optional）。标准 PAR DLI（umol/m²/day）。项目内无 PAR 实测或可信转换时 value 为 null 且 status=unavailable_pending_measurement；此时禁止用于精准补光控制。",
          "additionalProperties": true,
          "properties": {
            "value": {"type": ["number", "null"]},
            "unit": {"const": "umol_m2_day"},
            "status": {"type": "string"},
            "reason": {"type": "string"},
            "derived_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "exception_handling": {
      "type": "array",
      "description": "异常处理规则：当某条件触发时执行对应动作。",
      "items": {
        "type": "object",
        "required": [
          "condition",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "condition": {
            "type": "string",
            "description": "触发条件，如 连续 3 日湿度 > 85%"
          },
          "action": {
            "type": "string",
            "description": "动作，如 加强通风 / 暂停灌溉 / 告警"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "critical"
            ]
          }
        }
      }
    },
    "execution_log": {
      "type": "array",
      "description": "【day-1 独占数据字段 A】配方执行回流日志。每次真实运行追加一条，是『配方→执行→结果』三元组的执行侧，事后补字段代价极高，必须 day-1 留位。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string",
            "description": "执行设备匿名 ID（孤儿设备社区可凭此对账）。"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "actual_params": {
            "type": "object",
            "description": "实际执行参数（与 environment 对照，算偏差）。"
          },
          "deviations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "description": "【day-1 独占数据字段 A】执行结果。与 execution_log 配对，是唯一能训练『环境→结果』预测模型的燃料。",
      "additionalProperties": false,
      "properties": {
        "survival_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "yield_g": {
          "type": "number",
          "minimum": 0,
          "description": "单株/单箱产量（克）。"
        },
        "yield_rating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "description": "用户/农艺师产量评分。"
        },
        "quality_notes": {
          "type": "string"
        },
        "failure_reason": {
          "type": "string",
          "description": "失败原因；非空表示本次配方未达预期，用于校准。"
        }
      }
    },
    "image_consent": {
      "type": "object",
      "description": "【day-1 独占数据字段 B】中文病虫害图像授权。PlantVillage 以欧美作物为主，中文场景标注图像是真空白；本字段在采集端即声明授权，避免事后法律/伦理返工。",
      "additionalProperties": false,
      "properties": {
        "captured": {
          "type": "boolean",
          "description": "是否采集了图像。"
        },
        "license": {
          "type": "string",
          "description": "图像许可，如 CC-BY-4.0 / 私有。"
        },
        "attribution": {
          "type": "string",
          "description": "署名/来源。"
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "AgriTrust 溯源：每条配方参数的依据，引用可验证率目标 100%。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "license": {
            "type": "string",
            "description": "该来源的许可条款。混合许可下必须逐条标注：recipe 级 license 只覆盖编排层分发，不代表任何单一来源的授权。未核实的来源写 unknown（…），不得猜。含 CC BY-NC-SA（如 FAO/FAOSTAT）来源时整包非商用。",
            "default": "unknown"
          },
          "data_quality": {
            "type": "string",
            "enum": [
              "measured",
              "interpolated",
              "modeled",
              "estimated",
              "unknown"
            ],
            "description": "该来源数据质量等级。measured=实测；interpolated=站点插值；modeled=模型模拟；estimated=估计；unknown=未核实。不编造。",
            "default": "unknown"
          },
          "trial_location": {
            "type": "string",
            "description": "该来源的试验地/数据采集地。未核实写 unknown（…），不得猜。混合许可下的法务刚需：让每条来源可追溯。",
            "default": "unknown"
          },
          "source_license": {
            "type": "string",
            "description": "该来源的许可条款（与 license 字段对齐的冗余字段，供机器读取）。混合许可下必须逐条标注。",
            "default": "unknown"
          },
          "license_note": {
            "type": "string",
            "description": "许可条款补充说明（GAP_AUDIT §B3 新增，v1.2.1）。用于说明 license=unknown 时的处理决策：是否保守占位为 CC BY-NC-SA 4.0，并说明为何无法核实原始许可。占位替换后应保留原始信息在此字段供法务追溯。"
          },
          "unknown_license_replaced_at": {
            "type": "string",
            "format": "date",
            "description": "该来源的 license 从 unknown 被占位替换的日期（GAP_AUDIT §B3 新增，v1.2.1）。格式 YYYY-MM-DD。此字段存在即说明原始许可未核实、经保守处理。法务审计时可用于识别哪些来源仍待核实。"
          },
          "url_unverified": {
            "type": "boolean",
            "description": "Stage 2.1（2026-10-24）：该来源的 URL 是否为不可核验的占位（true 表示 url 为空或无法 200 访问）。用于诚实标注'无公开 URL'而非编造链接。",
            "default": false
          },
          "url_unverified_reason": {
            "type": "string",
            "description": "Stage 2.1（2026-10-24）：url_unverified=true 时的原因说明。例：'该来源无公开可核验 URL；配方数据本身仍基于该数据集，但用户无法自行访问原始数据点。'"
          }
        }
      }
    },
    "license": {
      "type": "string",
      "description": "配方许可；基础配方 CC-BY-4.0，高级配方包可商用授权。",
      "default": "CC-BY-4.0"
    },
    "license_scope": {
      "type": "string",
      "description": "许可适用范围声明：说明 recipe 级 license 与 sources[].license 的关系，以及是否存在限制整包商用性的来源（如 CC BY-NC-SA）。"
    },
    "companion_plants": {
      "type": "object",
      "description": "OpenFarm 共识字段（v1.2 新增，optional）。同分区伴生候选植物列表。本项目当前用 crop_adapt_db 同分区 Top-K 作占位（非最优伴生），字段带 source/derived_at 元数据。",
      "additionalProperties": true,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "crop": {"type": "string"},
              "latin": {"type": "string"},
              "adapt_score": {"type": "number"},
              "reason": {"type": "string"}
            }
          }
        },
        "source": {"type": "string"},
        "derived_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      }
    },
    "sowing_depth_cm": {
      "type": "object",
      "description": "OpenFarm 共识字段（v1.2 新增，optional）。播种深度（cm），从 crop_adapt_db.growth_days 派生（公式 round(growth_days/200, 1)）。缺 growth_days 时值为 null 且必带 reason（不编造纪律）。",
      "additionalProperties": true,
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"const": "cm"},
        "growth_days": {"type": "number"},
        "method": {"type": "string"},
        "source": {"type": "string"},
        "derived_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string"}
      }
    },
    "source_spans": {
      "type": "object",
      "description": "字段级血缘（P0-5）：标注每个高危派生字段的来源、转换方法与推论。键为字段路径（如 sowing_depth_cm / environment.shortwave_photon_equivalent），值为来源声明（derivation / source / inference / evidence_grade / unsafe_for_execution 等）。键动态，值用 additionalProperties 松散校验。",
      "additionalProperties": true
    }
  },
  "schema_version": "1.2.1"
}